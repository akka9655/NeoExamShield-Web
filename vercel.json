{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/d", "destination": "/NeoExamShield.zip", "permanent": false },
    { "source": "/d/", "destination": "/NeoExamShield.zip", "permanent": false },
    { "source": "/download", "destination": "/NeoExamShield.zip", "permanent": false }
  ],
  "rewrites": [
    { "source": "/a", "destination": "/a.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization" }
      ]
    },
    {
      "source": "/(.*)\\.zip",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"NeoExamShield.zip\"" },
        { "key": "Content-Type", "value": "application/zip" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.(svg|png|jpg|jpeg|gif|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
